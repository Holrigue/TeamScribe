# ============================================================================
# TeamScribe configuration — copy this file to ".env" and fill in the values.
# The ".env" file is git-ignored and must NEVER be committed.
# Nothing here is written to the Windows registry.
# ============================================================================

# --- LLM backend (summarization + session naming) ---
# "anthropic" (default, Claude) or "openai". Only the official OpenAI API
# is supported — no custom base URL — to avoid pointing the app at an
# untrusted endpoint with your API key.
TEAMSCRIBE_LLM_PROVIDER=anthropic

# --- Anthropic (used when TEAMSCRIBE_LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; defaults to the model below.
TEAMSCRIBE_SUMMARY_MODEL=claude-sonnet-4-6

# --- OpenAI (used when TEAMSCRIBE_LLM_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; defaults to the model below.
TEAMSCRIBE_OPENAI_MODEL=gpt-4o-mini

# --- Microsoft Entra ID (Azure AD) app registration ---
# Client ID of YOUR app registration (see README "Microsoft setup").
# This is distinct from the "no local admin" constraint: registering an app
# is a tenant-level action that may require a one-off request to your IT dept
# if self-service app registration is disabled in your tenant.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Use "organizations" for a work/school account, or your tenant GUID.
AZURE_TENANT_ID=organizations

# --- Microsoft Planner target (filled in automatically by `teamscribe setup`) ---
PLANNER_PLAN_ID=
PLANNER_BUCKET_ID=

# --- Recording behaviour ---
# Maximum recording length in minutes before auto-stop (Ctrl+C also stops).
TEAMSCRIBE_MAX_MINUTES=120

# --- Transcription ---
# large-v3-turbo (recommended) or large-v3. Do NOT use a French fine-tuned
# variant — see README "Why not a French model".
TEAMSCRIBE_WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu  (auto picks CUDA float16 if available, else CPU int8)
TEAMSCRIBE_DEVICE=auto
